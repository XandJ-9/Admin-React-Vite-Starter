# 应用配置
APP_NAME=Admin Starter Backend
DEBUG=true

# 数据库：默认 SQLite，切换 PostgreSQL 改为 postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./db/app.db

# JWT
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS：逗号分隔的允许来源
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 飞书 OAuth（可选，留空则飞书登录接口返回“未配置”）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:5173/auth/feishu/callback
